# Organização do Azure DevOps (a parte depois de https://dev.azure.com/)
AZURE_DEVOPS_ORG=minha-org
# Nome do projeto
AZURE_DEVOPS_PROJECT=MeuProjeto
# Personal Access Token com scope "Work Items: Read & Write"
AZURE_DEVOPS_PAT=cole-seu-pat-aqui

# (Opcional) Reference name do campo "Horas consumidas".
# Se vazio, o servidor descobre pelo nome exibido e cai para Microsoft.VSTS.Scheduling.CompletedWork.
AZURE_DEVOPS_HOURS_FIELD=
# (Opcional) Reference name do campo "Horas estimadas" (só leitura; padrão: descoberta / OriginalEstimate)
AZURE_DEVOPS_ESTIMATE_FIELD=
# (Opcional) Reference name de "Data de início" (preenchido ao mover uma task de New para Active)
AZURE_DEVOPS_START_DATE_FIELD=

# Segredo que protege o endpoint /mcp. Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=troque-por-um-segredo-longo

PORT=3000
# Fuso usado quando "date" não é informado
TIMEZONE=America/Sao_Paulo
